{# tab : Documents #}
                
<div class="pb-30 h-50">

    {% for document in get_documents() %}

        {% if file.extrafields is not null and file.extrafields['document'] is not null %}

            <div class="flex middle fit sm">
                <div class="w-15 blue-frame shape:1/1">
                    <img class="w-80 sm mr-5" src="{{ absolute_url(asset('icons/' ~ document.image1)) }}">
                </div>
                <h3 class="ml-15 w-65">{{ document.title }}</h3>

                <div class="flex group sm middle right w-20">
                    <a class="w-45 pointer center" href="{{ file.extrafields['document'] }}" target="_blank">
                        <img width="28" src="{{ absolute_url(asset('icons/visible.svg')) }}">
                    </a>

                    {% if isApplication is null %}

                        {% if bundleForm %}
                            {{ form_start(bundleForm, {'attr': {'class': 'w-45 pointer center z1'}}) }}
                                <input 
                                    type="hidden"
                                    name="{{ field_name(bundleForm.documents) }}" 
                                    value="{{ null }}"
                                >
                                <button>
                                    <img width="20" src="{{ absolute_url(asset('icons/trash.svg')) }}">
                                </button>

                                {{ form_widget(bundleForm._token) }}
                            {{ form_end(bundleForm, {'render_rest': false}) }}
                        {% endif %}
                    
                    {% endif %}
                </div>
            </div>
        {% else %}

            {% if isApplication is not null %}

                <div class="center">
                    <img width="42" src="{{ absolute_url(asset('icons/puzzle.svg')) }}">
                    <p class="my-20">{{ 'document.no_documents_added'|trans }}</p>
                </div>
            {% else %}

                <div class="center w-80">

                    <p class="pdl-infos-box t-left mb-3">
                        {{ 'document.partner_text'|trans }}<a href="{{ document.link }}" target="_blank">{{ document.websiteUrl }}</a> {{ document.textElement }}
                        <img class="pb-5" width="16" src="{{ absolute_url(asset('icons/' ~ document.image2)) }}"> .
                    </p>
                    
                    <div class="pt-5 pb-3">

                        <button
                            class="btn white t-thin w-90 middle py-0"
                            zb-popup="document-popup"
                        >
                            <img class="w-75" src="{{ absolute_url(asset('icons/' ~ document.image3)) }}">
                        </button>
                    </div>
                </div>
            {% endif %}
        {% endif %}
    {% endfor %}
</div>

<!-- Popup : Document-->

{% for document in get_documents() %}


    {% if file.extrafields is null or file.extrafields['document'] is null  and isApplication is null %}

        <zb-popup
            id="document-popup"
            pdl-display="full"
            zb-backdrop="false"
        >

            <img zb-close class="ml-15 pb-30" width="11" src="{{ absolute_url(asset('icons/chevron-left.svg')) }}">
            
            {{ form_start(bundleForm) }}

                <div class="px-25 pb-3 mb-1 w-90">

                    <p class="mb-1">{{ 'document.popupLabel'|trans({'partner': partner }) }}</p>

                    <zb-input
                        name="{{ field_name(bundleForm.documents) }}" 
                        value="{{ field_value(bundleForm.documents) }}"
                        type="text"
                        placeholder="{{ 'document.placeholder'|trans({'partner': partner }) }}"
                        pattern="{{ document.pattern }}"
                        class="mb-0"
                        message="{
                            display: 'top',
                            pattern: "{{ 'document.patternMessage'|trans({'partner': partner }) }}",
                        }"
                    ></zb-input>

                    <a class="mt-10 ml-5 s5 t-color underline" href="{{ document.link }}" target="_blank">
                        {{ 'document.createPartnerFile'|trans({'partner': partner }) }}
                    </a>
                </div>

                <div class="pdl-ctas-footer center p-20">

                    <button class="btn w-90 p-15">
                        {{ 'document.validate'|trans }}
                    </button>
                </div>

                {{ form_widget(bundleForm._token) }}
            {{ form_end(bundleForm, {'render_rest': false}) }}
        </zb-popup>
    {% endif %}
{% endfor %}