{# tab : Documents #}
                
            <div class="pb-30 h-50">

                {% if document %}
                    <div class="flex middle fit sm">
                        <div class="w-15 blue-frame shape:1/1">
                            <img class="w-80 sm mr-5" src="{{ absolute_url(asset('icons/republique-francaise.svg')) }}">
                        </div>
                        <h3 class="ml-15 w-65">Dossier facile</h3>

                        <div class="flex group sm middle right w-20">
                            <a class="w-45 pointer center" href="{{file.documents}}" target="_blank">
                                <img width="28" src="{{ absolute_url(asset('icons/visible.svg')) }}">
                            </a>

                            {% if isApplication is not defined %}

                                {{ form_start(form, {'attr': {'class': 'w-45 pointer center z1'}}) }}
                                    <input 
                                        type="hidden"
                                        name="{{ field_name(form.documents) }}" 
                                        value="{{ null }}"
                                    >
                                    <button>
                                        <img width="20" src="{{ absolute_url(asset('icons/trash.svg')) }}">
                                    </button>

                                    {{ form_widget(form._token) }}
                                {{ form_end(form, {'render_rest': false}) }}
                            {% endif %}
                        </div>
                    </div>

                {% else %}

                    {% if isApplication is defined %}
                        <div class="center">
                            <img width="42" src="{{ absolute_url(asset('icons/puzzle.svg')) }}">
                            <p class="my-20">0 document ajouté</p>

                        </div>
                    {% else %}
                        <div class="center w-80">

                            <p class="pdl-infos-box t-left mb-3">
                                123 Loger s'allie avec <a href="https://www.dossierfacile.logement.gouv.fr/?mtm_campaign=123loger" target="_blank">DossierFacile.fr</a> pour un dossier numérique sécurisé et vérifié par l'État 
                                <img class="pb-5" width="16" src="{{ absolute_url(asset('icons/french-flag.svg')) }}"> .
                            </p>
                            
                            <div class="pt-5 pb-3">

                                <button
                                    class="btn white t-thin w-90 middle py-0"
                                    zb-popup="dossier-facile"
                                >
                                    <img class="w-75" src="{{ absolute_url(asset('icons/dossier-facile.svg')) }}">
                                </button>
                            </div>
                        </div>
                    {% endif %}
                {% endif %}
            </div>